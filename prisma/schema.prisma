// NURAE V00.01.000-beta-02 — FRAZIYM TECH & AI
// Data model. SQLite/libSQL dialect. The SAME schema serves local development
// (file: URL via the libsql driver adapter — embedded libSQL) and serverless
// deployments such as Vercel (libsql:// URL — hosted Turso). The schema is
// intentionally simple and standard (no platform-specific column types,
// no JSON columns).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bots Bot[]

  @@map("projects")
}

model Bot {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  // Owner: null = platform-owned (the official NURAE bot, admin-managed).
  // A user id = a customer-built bot; every API touching the bot must derive
  // ownership from the session, never from a client-supplied id.
  ownerId     String?  @map("owner_id")
  name        String
  description String   @default("")
  // Telegram username is resolved via getMe when the bot starts (e.g. "@my_bot").
  telegramUsername     String? @map("telegram_username")
  // Encrypted Telegram bot token (AES-256-GCM via SecretManager). NEVER returned by APIs.
  // Null until the owner adds a token (the official NURAE bot exists before that).
  telegramTokenRef     String? @map("telegram_token_reference")
  // Optional encrypted AI provider API key. NEVER returned by APIs.
  apiKeyRef            String? @map("api_key_reference")
  // Optional base URL override for openai-compatible providers.
  baseUrl              String? @map("base_url")
  systemPrompt         String  @default("You are a helpful assistant. Answer clearly and concisely.") @map("system_prompt")
  provider             String  @default("openrouter") // openai | openrouter | deepseek | glm | local | custom
  model                String  @default("openrouter/free") @map("model")
  temperature          Float   @default(0.7)
  maxTokens            Int     @default(1024) @map("max_tokens")
  // Short-term conversation memory: number of recent messages kept per chat.
  memorySize           Int     @default(10) @map("memory_size")
  // Bot capabilities (JSON, SQLite has no JSON type):
  // behaviors_json  = SOURCE OF TRUTH behaviors (intent-first building) —
  //                   [{ id, title, when: {type: "start"|"command"|"says"|"button"|"anything_else", …},
  //                      steps: [{type:"message", text, buttons?}|{type:"ai", instruction?}] }]
  // commands_json   = compiled artifact [{ command, description, kind: "static"|"ai", response }]
  // replies_json    = compiled artifact [{ id, name, trigger: {type, value},
  //                   messages: [{ text, ai?, buttons: [[{ text, url?|callback? }]] }] }]
  // The Behavior compiler (src/lib/nurae/bots/behavior.ts) derives commands +
  // replies from behaviors; the pipeline executes only the compiled artifacts.
  commandsJson         String? @map("commands_json")
  repliesJson          String? @map("replies_json")
  behaviorsJson        String? @map("behaviors_json")
  // Archived bots stay runnable-but-hidden for their owner; delete removes rows.
  archived             Boolean @default(false)
  enabled              Boolean @default(true)
  status               String  @default("stopped") // stopped | starting | running | stopping | error
  statusDetail         String? @map("status_detail") // last error / human-readable status info
  // Transport resolved at the last start: "webhook" | "polling" (null: never started).
  transport            String?
  // Encrypted per-bot webhook secret (set on every webhook-mode start; Telegram
  // echoes it back in X-Telegram-Bot-Api-Secret-Token). NEVER returned by APIs.
  webhookSecretRef     String? @map("webhook_secret_reference")
  lastStartedAt        DateTime? @map("last_started_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  logs          Log[]

  @@index([projectId])
  @@index([ownerId])
  @@map("bots")
}

model Conversation {
  id        String   @id @default(cuid())
  botId     String   @map("bot_id")
  // Telegram chat id (string to stay portable across platforms/DBs).
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bot      Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([botId, chatId])
  @@index([botId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String // user | assistant | system
  content        String
  timestamp      DateTime @default(now()) @map("timestamp")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("messages")
}

model Log {
  id        String   @id @default(cuid())
  botId     String?  @map("bot_id") // null => system-level (NURAE core) log
  level     String // info | warn | error
  // Structured event code (Step 9): BOT_CREATED, BOT_STARTING, TELEGRAM_MESSAGE_RECEIVED, …
  event     String?
  message   String
  timestamp DateTime @default(now()) @map("timestamp")

  bot Bot? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, timestamp])
  @@map("logs")
}

// ---------------------------------------------------------------------------
// Platform layer — customer accounts, sessions, email verification, site data
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  // scrypt hash ("scrypt$N$r$p$salt$hash"). Null ⇒ Google-only account.
  passwordHash  String?  @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  // Google account subject id ("sub" claim) when the user signed up via Google.
  googleId      String?  @unique @map("google_id")
  avatarUrl     String?  @map("avatar_url")
  // user (reserved for future roles)
  role          String   @default("user")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // Random 32-byte token (hex). Stored plain — the cookie value IS the token;
  // compromise of the DB already implies compromise of live sessions.
  token     String   @unique
  // Human-readable context for the admin Customers view.
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // scrypt hash of the 6-digit code — a DB leak must not expose codes.
  codeHash  String   @map("code_hash")
  // email_verify (future: password_reset)
  purpose   String   @default("email_verify")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Chats + Agents — conversation sessions for the user-facing product
// ---------------------------------------------------------------------------

// One conversation in /chats (kind="chat") or one agent workspace thread
// (kind="agent"). Agent sessions carry durable task state in `state` (JSON):
// draft bot id, pending confirmation, referenced file ids, last plan.
model ChatSession {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  // chat | agent
  kind           String   @default("chat")
  // For agent sessions: "bot-builder" (more agents planned, never faked).
  agent          String?
  title          String   @default("New chat")
  // Free-form JSON task state owned by the agent runtime.
  state          String?
  // active | archived
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastMessageAt  DateTime? @map("last_message_at")

  entries   ChatEntry[]
  steps     AgentStep[]
  files     UserFile[]

  @@index([userId, kind, status])
  @@index([userId, lastMessageAt])
  @@map("chat_sessions")
}

// One message inside a session. `meta` (JSON) carries attachments, agent
// activity and handoff references:
//   attachments: [{ fileId, name, kind }]
//   activity:    [{ seq, label, status: "ok"|"error"|"confirm", detail? }]
//   handoff:     { agent, sessionId, taskId }
model ChatEntry {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  // user | assistant | system | tool
  role       String
  content    String
  meta       String?
  createdAt  DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_entries")
}

// Durable audit trail of every tool invocation an agent made. This is the
// "understandable progress" surface — and the security audit log.
model AgentStep {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  seq        Int
  // Tool name from the registry (e.g. "bot_create_draft").
  tool       String
  argsJson   String   @map("args_json")
  resultJson String?  @map("result_json")
  // ok | error | confirm (waiting for the user) 
  status     String   @default("ok")
  // Human-readable one-liner shown in the activity list.
  label      String
  createdAt  DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("agent_steps")
}

// ---------------------------------------------------------------------------
// Files — user uploads (knowledge / input for chats and agents)
// ---------------------------------------------------------------------------

// Small text files keep their content inline; binaries live on disk
// (db/uploads/) with `storagePath`. `extractedText` powers retrieval so the
// agent never needs the raw binary.
model UserFile {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  // Session the file was attached in (nullable = account-level file).
  sessionId     String?  @map("session_id")
  name          String
  mime          String
  size          Int
  // text | pdf | docx | csv | image | other
  kind          String
  content       String?
  storagePath   String?  @map("storage_path")
  extractedText String?  @map("extracted_text")
  // ready | binary | failed
  status        String   @default("ready")
  createdAt     DateTime @default(now()) @map("created_at")

  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("user_files")
}

// ---------------------------------------------------------------------------
// Referrals + entitlements — temporary premium access, tracked server-side
// ---------------------------------------------------------------------------

// One shareable invite code per user (created lazily on first visit).
model Referral {
  id        String   @id @default(cuid())
  inviterId String   @unique @map("inviter_id")
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("referrals")
}

// One qualification per invited user — the abuse guard IS the schema
// (unique invited user; the inviter must differ; qualification happens
// server-side when the invited account verifies its email).
model ReferralReward {
  id             String   @id @default(cuid())
  inviterId      String   @map("inviter_id")
  invitedUserId  String   @unique @map("invited_user_id")
  // Reward days granted (currently 2 — decided by the server, not the client).
  days           Int      @default(2)
  // pending | qualified
  status         String   @default("pending")
  qualifiedAt    DateTime? @map("qualified_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([inviterId])
  @@map("referral_rewards")
}

// A temporary feature grant. NOT a boolean "premium" flag: entitlements are
// per-feature with an expiry, so future rewards can be scoped (extra agents,
// storage, models) without another migration.
model Entitlement {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // "premium" today; more features later.
  feature   String
  // referral | (future: promo, purchase)
  source    String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, feature])
  @@map("entitlements")
}

// ---------------------------------------------------------------------------
// Bot ecosystem layer — per-user state, scheduler, broadcasts, Stars payments
// (the primitives behind forms, reminders, newsletters, shops and groups)
// ---------------------------------------------------------------------------

// Per-chat persistent attributes for one bot (the "who is this user / what
// did they tell us" store): collected answers, carts, progress, start
// payloads. `awaiting` + resume power multi-turn forms: when set, the next
// inbound text from this chat is stored as that attribute and the flow
// continues at (resumeRuleId, resumeStep).
model BotUserState {
  id           String   @id @default(cuid())
  botId        String   @map("bot_id")
  // Telegram chat id (string for portability, like Conversation.chatId).
  chatId       String   @map("chat_id")
  // JSON object of string attributes (SQLite has no JSON type).
  attributes   String   @default("{}") @map("attributes_json")
  // Attribute currently being collected (collect step), or "_schedule" while
  // the bot parses a reminder time. Null = nothing pending.
  awaiting     String?
  // Where a multi-turn flow continues after the pending answer.
  resumeRuleId String?  @map("resume_rule_id")
  resumeStep   Int?
  // Last /start deep-link payload (referral attribution, bind-a-chat flows).
  startPayload String?  @map("start_payload")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([botId, chatId])
  @@index([botId])
  @@map("bot_user_states")
}

// One delayed/recurring outbound message (reminders, digests, drip content).
// Executed by the task ticker (runtime/tasks.ts); `runAt` is UTC.
model BotSchedule {
  id         String   @id @default(cuid())
  botId      String   @map("bot_id")
  chatId     String   @map("chat_id")
  // Markdown text delivered when due (converted to Telegram HTML on send).
  text       String
  runAt      DateTime @map("run_at")
  // once | daily | weekly
  recurrence String   @default("once")
  // pending | sent | cancelled | failed
  status     String   @default("pending")
  lastError  String?  @map("last_error")
  // Set for reminder-type schedules so users can list/cancel their own.
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([botId, status, runAt])
  @@map("bot_schedules")
}

// One owner broadcast fan-out to every chat the bot has ever talked to.
// Claimed atomically (pending → running) by the task ticker; delivery is
// paced under Telegram's broadcast limits (~30 msg/s global).
model BotBroadcast {
  id        String   @id @default(cuid())
  botId     String   @map("bot_id")
  text      String
  // pending | running | done | failed
  status    String   @default("pending")
  total     Int      @default(0)
  sent      Int      @default(0)
  failed    Int      @default(0)
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([botId, status])
  @@map("bot_broadcasts")
}

// One completed Stars payment (successful_payment service message).
// chargeId is Telegram's telegram_payment_charge_id — unique, the refund key.
model BotPayment {
  id        String   @id @default(cuid())
  botId     String   @map("bot_id")
  chatId    String   @map("chat_id")
  chargeId  String   @unique @map("charge_id")
  amount    Int
  currency  String   @default("XTR")
  payload   String
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([botId])
  @@map("bot_payments")
}
