// NURAE V00.01.000-beta-02 — FRAZIYM TECH & AI
// Data model. SQLite/libSQL dialect. The SAME schema serves local development
// (file: URL via the libsql driver adapter — embedded libSQL) and serverless
// deployments such as Vercel (libsql:// URL — hosted Turso). The schema is
// intentionally simple and standard (no platform-specific column types,
// no JSON columns).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bots Bot[]

  @@map("projects")
}

model Bot {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String   @default("")
  // Telegram username is resolved via getMe when the bot starts (e.g. "@my_bot").
  telegramUsername     String? @map("telegram_username")
  // Encrypted Telegram bot token (AES-256-GCM via SecretManager). NEVER returned by APIs.
  // Null until the owner adds a token (the official NURAE bot exists before that).
  telegramTokenRef     String? @map("telegram_token_reference")
  // Optional encrypted AI provider API key. NEVER returned by APIs.
  apiKeyRef            String? @map("api_key_reference")
  // Optional base URL override for openai-compatible providers.
  baseUrl              String? @map("base_url")
  systemPrompt         String  @default("You are a helpful assistant. Answer clearly and concisely.") @map("system_prompt")
  provider             String  @default("openrouter") // openai | openrouter | deepseek | glm | local | custom
  model                String  @default("openrouter/free") @map("model")
  temperature          Float   @default(0.7)
  maxTokens            Int     @default(1024) @map("max_tokens")
  // Short-term conversation memory: number of recent messages kept per chat.
  memorySize           Int     @default(10) @map("memory_size")
  enabled              Boolean @default(true)
  status               String  @default("stopped") // stopped | starting | running | stopping | error
  statusDetail         String? @map("status_detail") // last error / human-readable status info
  // Transport resolved at the last start: "webhook" | "polling" (null: never started).
  transport            String?
  // Encrypted per-bot webhook secret (set on every webhook-mode start; Telegram
  // echoes it back in X-Telegram-Bot-Api-Secret-Token). NEVER returned by APIs.
  webhookSecretRef     String? @map("webhook_secret_reference")
  lastStartedAt        DateTime? @map("last_started_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  logs          Log[]

  @@index([projectId])
  @@map("bots")
}

model Conversation {
  id        String   @id @default(cuid())
  botId     String   @map("bot_id")
  // Telegram chat id (string to stay portable across platforms/DBs).
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bot      Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([botId, chatId])
  @@index([botId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String // user | assistant | system
  content        String
  timestamp      DateTime @default(now()) @map("timestamp")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("messages")
}

model Log {
  id        String   @id @default(cuid())
  botId     String?  @map("bot_id") // null => system-level (NURAE core) log
  level     String // info | warn | error
  // Structured event code (Step 9): BOT_CREATED, BOT_STARTING, TELEGRAM_MESSAGE_RECEIVED, …
  event     String?
  message   String
  timestamp DateTime @default(now()) @map("timestamp")

  bot Bot? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, timestamp])
  @@map("logs")
}

// ---------------------------------------------------------------------------
// Platform layer — customer accounts, sessions, email verification, site data
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  // scrypt hash ("scrypt$N$r$p$salt$hash"). Null ⇒ Google-only account.
  passwordHash  String?  @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  // Google account subject id ("sub" claim) when the user signed up via Google.
  googleId      String?  @unique @map("google_id")
  avatarUrl     String?  @map("avatar_url")
  // user (reserved for future roles)
  role          String   @default("user")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // Random 32-byte token (hex). Stored plain — the cookie value IS the token;
  // compromise of the DB already implies compromise of live sessions.
  token     String   @unique
  // Human-readable context for the admin Customers view.
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // scrypt hash of the 6-digit code — a DB leak must not expose codes.
  codeHash  String   @map("code_hash")
  // email_verify (future: password_reset)
  purpose   String   @default("email_verify")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
