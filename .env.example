# ============================================================================
# NURAE V00.01.000-beta-02 — FRAZIYM TECH & AI
# Environment configuration (placeholders only — never commit real secrets).
# ============================================================================

# --- Database ----------------------------------------------------------------
# Local development: embedded libSQL (created automatically).
DATABASE_URL=file:./db/custom.db

# Vercel / serverless: point DATABASE_URL at a hosted Turso database instead.
#   DATABASE_URL=libsql://your-db-yourorg.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
# Apply the schema with:  bun run db:push        (local file)
#   or generate SQL for Turso:
#     bunx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script | turso db shell $DATABASE_URL
# DATABASE_AUTH_TOKEN=

# --- Secrets ----------------------------------------------------------------
# Master key for encrypting Telegram tokens / AI API keys / webhook secrets at
# rest (AES-256-GCM). REQUIRED on Vercel (there is no writable filesystem).
# Use a long random string (>= 32 chars). If unset locally, NURAE generates a
# machine-local key file at db/.nurae-secret-key automatically.
NURAE_SECRET_KEY=change-me-to-a-long-random-string

# --- Dashboard authentication (REQUIRED outside localhost) ------------------
# When set, the dashboard and every administrative API endpoint require this
# token (HttpOnly cookie after login, or Authorization: Bearer). When unset,
# admin access is open — localhost development mode only, never in production.
NURAE_ADMIN_TOKEN=change-me-if-exposed

# --- Bot transport (Step 5) ---------------------------------------------------
# webhook (default): Telegram POSTs updates to NURAE — the only mode that
#   works on Vercel. The public base URL is derived from request headers;
#   override here when running behind an unusual proxy:
# NURAE_PUBLIC_BASE_URL=https://your-app.vercel.app
# polling: in-process long-poll loop for local development without a public
#   URL. Refuses to start on serverless platforms (no persistent process).
# NURAE_BOT_TRANSPORT=webhook

# --- Split deployment (frontend on Vercel, backend elsewhere) ----------------
# Set ONLY on the frontend deployment: every /api/* request is proxied to
# this backend URL at the rewrite level (same-origin, cookies keep working).
# Leave unset for the normal single-process app (local dev, Actions runner).
# Used by .github/workflows/split-e2e.yml. Build-time variable: changing it
# requires a rebuild/redeploy of the frontend.
# NURAE_BACKEND_URL=https://your-tunnel-or-host.example.com

# --- Gateway Link (frontend ⇄ backend runtime connection) --------------------
# The build-time alternative above is superseded by the Gateway Link: the
# backend registers its public origin with the frontend at runtime and the
# frontend proxies /api/* through middleware — no rebuild when the backend
# moves. Both sides must share the same secret.
#
#   Frontend (Vercel): NURAE_GATEWAY_KEY enables gateway mode — accepts
#     registrations at POST /api/gateway/register and proxies all /api/* to
#     the linked backend. Also connect a Vercel Blob store to the project
#     (the link record lives there; BLOB_READ_WRITE_TOKEN is injected).
#   Backend: NURAE_LINK_FRONTEND_URL + NURAE_GATEWAY_KEY make the backend
#     register itself on boot and re-register every 60 s (tunnel origins
#     change per boot).
#
# Generate the key with:  openssl rand -hex 24
# Used by .github/workflows/split-e2e.yml (frontend=gateway mode).
# NURAE_GATEWAY_KEY=
# NURAE_LINK_FRONTEND_URL=https://nurae.vercel.app

# --- Testing override (leave unset in production) -----------------------------
# Point the Telegram adapter at a mock API server:
# NURAE_TELEGRAM_API_BASE=http://127.0.0.1:3131

# --- AI provider API keys (optional per-bot fallbacks) ----------------------
# Keys can be stored per-bot in the dashboard (encrypted); these env vars act
# as fallbacks so bots can omit their own key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
LOCAL_API_KEY=
CUSTOM_API_KEY=
