# ============================================================================
# NURAE V00.01.007-beta-03 — FRAZIYM TECH & AI
# Complete environment configuration template.
#
# HOW TO USE:
#   cp .env.example .env        then edit .env with your real values.
#   .env is git-ignored — NEVER commit it, NEVER commit real secrets.
#   Every value below is a placeholder. Anything left as "change-me" will
#   either refuse to start or behave insecurely.
#
# Sections:
#   1. Required (single-process app — local dev AND your own server)
#   2. Server / port binding
#   3. Bot transport (how Telegram reaches your bots)
#   4. AI provider keys (optional fallbacks)
#   5. Advanced — Gateway Link (split frontend/backend), only if you split
#   6. CI/E2E only — leave unset everywhere else
# ============================================================================

# ============================================================================
# 1. REQUIRED — core single-process configuration
# ============================================================================

# --- Database (SQLite file) ---------------------------------------------------
# Local file database. Use an ABSOLUTE path in production and keep it on a
# filesystem that supports SQLite WAL (Termux: $HOME, NOT /sdcard — shared
# Android storage does not support WAL and will corrupt or fail).
#   Termux:      DATABASE_URL=file:/data/data/com.termux/files/home/nurae/data/nurae.db
#   Linux box:   DATABASE_URL=file:/var/lib/nurae/nurae.db
DATABASE_URL=file:./db/custom.db

# --- Remote libSQL/Turso auth token (ONLY when DATABASE_URL is libsql://) ------
# Leave unset for local SQLite files. Used when you host the DB on Turso.
# DATABASE_AUTH_TOKEN=

# --- Master secret (REQUIRED outside localhost) --------------------------------
# AES-256-GCM master key used to encrypt Telegram bot tokens, AI API keys and
# webhook secrets at rest in the database. Losing it = losing every stored
# secret (they cannot be decrypted). Changing it after bots exist = same.
# Generate:  openssl rand -hex 32
# If unset locally, a machine-local key file is generated at db/.nurae-secret-key
# (convenient for dev; explicit is better for a server).
NURAE_SECRET_KEY=change-me-to-a-long-random-string-32-chars-min

# --- Dashboard admin token (REQUIRED outside localhost) ------------------------
# The dashboard and every administrative API endpoint require this token
# (login form sets an HttpOnly cookie; API clients use Authorization: Bearer).
# When unset, admin access is OPEN — acceptable only for localhost dev.
# Generate:  openssl rand -hex 24
NURAE_ADMIN_TOKEN=change-me-if-exposed

# ============================================================================
# 2. SERVER / PORT BINDING (production standalone server)
# ============================================================================

# `npm run start` runs the compiled standalone server. It binds:
#   HOSTNAME=0.0.0.0  PORT=3000
# Change PORT if 3000 is taken; keep HOSTNAME=0.0.0.0 when a reverse proxy
# (nginx/Caddy) or another device must reach the server.
# HOSTNAME=0.0.0.0
# PORT=3000

# ============================================================================
# 3. BOT TRANSPORT — how Telegram delivers messages to your bots
# ============================================================================

# webhook (default): Telegram POSTs updates to your PUBLIC HTTPS URL.
#   Requires a reachable public base URL. Set it explicitly when running
#   behind your own domain/proxy:
#     NURAE_PUBLIC_BASE_URL=https://bots.your-domain.com
#   For a quick local test use a cloudflared quick tunnel and paste its URL:
#     NURAE_PUBLIC_BASE_URL=https://<something>.trycloudflare.com
#   (see SETUP.md §5 — the tunnel URL changes on every tunnel restart)
#
# polling: in-process long-poll loop. ZERO public URL needed — ideal for
#   local testing (Termux, laptop). Set this and you do NOT need
#   NURAE_PUBLIC_BASE_URL. Refuses to start on serverless platforms.
# NURAE_BOT_TRANSPORT=webhook

# ============================================================================
# 4. AI PROVIDER KEYS (optional fallbacks)
# ============================================================================
# Preferred way: configure each bot's provider in the dashboard — keys are
# encrypted at rest with NURAE_SECRET_KEY. The env vars below act as
# account-wide fallbacks for bots that have no key of their own.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
LOCAL_API_KEY=
CUSTOM_API_KEY=

# ============================================================================
# 5. ADVANCED — Gateway Link (split frontend ⇄ backend) — NOT needed for
#    single-process self-hosting. Only relevant when the dashboard frontend
#    is deployed separately (e.g. Vercel) while bots run here.
# ============================================================================
# Backend side: register this backend with a remote frontend and refresh
# every 60 s (tunnel origins change per boot). Requires NURAE_PUBLIC_BASE_URL.
# NURAE_LINK_FRONTEND_URL=https://nurae.vercel.app
# NURAE_GATEWAY_KEY=
#
# Frontend side (separate dashboard deployment): enabling key + link store.
# On Vercel a TEMPORARY bootstrap key is hardcoded in
# src/lib/gateway/bootstrap-key.ts (PUBLIC — remove/rotate it; an explicit
# NURAE_GATEWAY_KEY env var always wins over it).
#
# Build-time alternative (legacy): proxy /api/* to a fixed backend at build.
# NURAE_BACKEND_URL=https://your-backend.example.com

# ============================================================================
# 6. CI / E2E ONLY — leave unset in normal operation
# ============================================================================
# Point the Telegram adapter at a different API base (integration testing):
# NURAE_TELEGRAM_API_BASE=http://127.0.0.1:3131
#
# Split-E2E driver (scripts/e2e.ts, used by .github/workflows/split-e2e.yml):
# E2E_BASE_URL / E2E_WEBHOOK_BASE / E2E_ADMIN_TOKEN / E2E_TELEGRAM_TOKEN /
# E2E_AI_API_KEY / E2E_PROVIDER / E2E_MODEL / E2E_MESSAGE_WAIT_SECONDS /
# E2E_GATEWAY_LINK
