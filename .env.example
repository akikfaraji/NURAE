# ============================================================================
# NURAE V00.00.000-beta-01 — FRAZIYM TECH & AI
# Environment configuration (placeholders only — never commit real secrets).
# ============================================================================

# --- Database ---------------------------------------------------------------
# SQLite for this release. The file is created automatically.
DATABASE_URL=file:./db/custom.db

# --- Secrets ----------------------------------------------------------------
# Master key for encrypting Telegram tokens / AI API keys at rest (AES-256-GCM).
# Use a long random string (>= 32 chars recommended). If unset, NURAE generates
# a machine-local key file at db/.nurae-secret-key automatically.
NURAE_SECRET_KEY=change-me-to-a-long-random-string

# --- Dashboard authentication (STRONGLY RECOMMENDED when not on localhost) ---
# When set, the dashboard and every administrative API endpoint require this
# token. When unset, admin access is open (localhost development mode only).
NURAE_ADMIN_TOKEN=change-me-if-exposed

# --- Bot runtime service ----------------------------------------------------
# Isolated process that owns running Telegram bots (mini-services/nurae-runtime).
NURAE_RUNTIME_PORT=3030
# Shared internal token between the API process and the runtime process.
# If unset, one is auto-generated at db/.nurae-runtime-token.
NURAE_RUNTIME_TOKEN=
NURAE_RUNTIME_TIMEOUT_MS=60000

# --- AI provider API keys (optional per-bot fallbacks) ----------------------
# Keys can be stored per-bot in the dashboard (encrypted); these env vars act
# as fallbacks so bots can omit their own key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
LOCAL_API_KEY=
CUSTOM_API_KEY=
